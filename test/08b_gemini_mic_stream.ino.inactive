// Step 8b - Gemini Live: Send Real Mic Audio
// Extends 8a: typing LISTEN over Serial triggers a fixed-duration mic
// capture, streamed live into the open session via realtimeInput in small
// ~100ms chunks - never buffering the whole capture in RAM. Confirms the
// server receives and responds to real spoken audio. The reply is parsed
// and logged (reusing 8a's detailed message breakdown) but not played back
// yet - that's step 8c. Onboard LED is on for the duration of the capture,
// off once it ends.
//
// Requires the "WebSockets" library by Markus Sattler (Links2004) and
// "ArduinoJson" by Benoit Blanchon (v7), both installable via the Arduino
// Library Manager. Base64 encoding uses mbedTLS, bundled with the ESP32
// Arduino core - no extra library needed for that.

#include <WiFi.h>
#include <WebSocketsClient.h>
#include <ArduinoJson.h>
#include <driver/i2s.h>
#include <math.h>
#include <mbedtls/base64.h>
#include <string.h>
#include "config.h"

namespace {
const char kGeminiHost[] = "generativelanguage.googleapis.com";
constexpr uint16_t kGeminiPort = 443;
const char kGeminiPath[] =
    "/ws/google.ai.generativelanguage.v1beta.GenerativeService.BidiGenerateContent?key=" GEMINI_API_KEY;

