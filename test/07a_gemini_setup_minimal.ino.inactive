// Step 7a - Gemini Live Session Setup (minimal)
// The smallest possible setup message: just model + response modality, no
// system instruction, no tools. This isolates whether ANY setup message
// gets a setupComplete reply at all, before adding content that could
// itself be malformed. If this hangs too, the problem isn't the JSON
// content of the fuller step 7 message - it's something more fundamental
// about sending over this connection.

#include <WiFi.h>
#include <WebSocketsClient.h>
#include "config.h"

namespace {
const char kGeminiHost[] = "generativelanguage.googleapis.com";
constexpr uint16_t kGeminiPort = 443;
const char kGeminiPath[] =
    "/ws/google.ai.generativelanguage.v1beta.GenerativeService.BidiGenerateContent?key=" GEMINI_API_KEY;

