const char kSetupMessage[] =
    R"JSON({"setup":{"model":"models/gemini-3.8-live","generationConfig":{"responseModalities":["AUDIO"]}}})JSON";

WebSocketsClient webSocket;
bool should_send_setup = false;
}  // namespace

/** Blocks until Wi-Fi connects, logging progress and the assigned IP. */
void connectToWifi() {
  Serial.printf("[gemini_setup_minimal][Step 7a] Connecting to Wi-Fi SSID \"%s\"...\n", WIFI_SSID);
  WiFi.mode(WIFI_STA);
  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);

  while (WiFi.status() != WL_CONNECTED) {
    delay(300);
    Serial.print(".");
  }

  Serial.println();
  Serial.printf("[gemini_setup_minimal][Step 7a] Wi-Fi connected. IP address: %s\n", WiFi.localIP().toString().c_str());
}

/** Blocks until SNTP has set a plausible system time, required for TLS cert validation. */
void syncSystemTime() {
  Serial.println("[gemini_setup_minimal][Step 7a] Syncing time via SNTP (required for TLS cert validation)...");
  configTime(0, 0, "pool.ntp.org", "time.nist.gov");

  time_t now = time(nullptr);
  while (now < 8 * 3600 * 2) {  // still near the 1970 epoch means time hasn't synced yet
    delay(300);
    Serial.print(".");
    now = time(nullptr);
  }

  Serial.println();
  Serial.printf("[gemini_setup_minimal][Step 7a] Time synced: %s", asctime(gmtime(&now)));
}

/** Handles WebSocket lifecycle events. Every event type is logged - including
    fragments/pings - so nothing arriving from the server goes unseen while
    we're debugging why no reply appeared to the naive TEXT-only handler. */
void onWebSocketEvent(WStype_t type, uint8_t* payload, size_t length) {
  switch (type) {
    case WStype_CONNECTED:
      Serial.println("[gemini_setup_minimal][Step 7a] WSS connected.");
      should_send_setup = true;
      break;
    case WStype_DISCONNECTED:
      Serial.println("[gemini_setup_minimal][Step 7a] Disconnected from the server.");
      break;
    case WStype_TEXT: {
      Serial.printf("[gemini_setup_minimal][Step 7a] Received TEXT (%u bytes): %.*s\n", (unsigned)length, (int)length, payload);
      String text(reinterpret_cast<char*>(payload), length);
      if (text.indexOf("setupComplete") >= 0) {
        Serial.println("[gemini_setup_minimal][Step 7a] setupComplete received - minimal setup works.");
      }
      break;
    }
    case WStype_BIN: {
      // The server appears to send its JSON replies over binary (opcode 0x2)
      // frames rather than text frames - printing as text to confirm.
      Serial.printf("[gemini_setup_minimal][Step 7a] Received BIN frame (%u bytes) as text: %.*s\n", (unsigned)length, (int)length, payload);
      String text(reinterpret_cast<char*>(payload), length);
      if (text.indexOf("setupComplete") >= 0) {
        Serial.println("[gemini_setup_minimal][Step 7a] setupComplete received (as a BIN frame) - minimal setup works.");
      }
      break;
    }
    case WStype_ERROR:
      Serial.printf("[gemini_setup_minimal][Step 7a] WebSocket error: %.*s\n", (int)length, payload);
      break;
    case WStype_FRAGMENT_TEXT_START:
      Serial.println("[gemini_setup_minimal][Step 7a] Fragmented TEXT started.");
      break;
    case WStype_FRAGMENT_BIN_START:
      Serial.println("[gemini_setup_minimal][Step 7a] Fragmented BIN started.");
      break;
    case WStype_FRAGMENT:
      Serial.printf("[gemini_setup_minimal][Step 7a] Fragment (%u bytes): %.*s\n", (unsigned)length, (int)length, payload);
      break;
    case WStype_FRAGMENT_FIN:
      Serial.printf("[gemini_setup_minimal][Step 7a] Final fragment (%u bytes): %.*s\n", (unsigned)length, (int)length, payload);
      break;
    case WStype_PING:
      Serial.println("[gemini_setup_minimal][Step 7a] Received PING.");
      break;
    case WStype_PONG:
      Serial.println("[gemini_setup_minimal][Step 7a] Received PONG.");
      break;
    default:
      Serial.printf("[gemini_setup_minimal][Step 7a] Unhandled event type %d.\n", (int)type);
      break;
  }
}

/** One-time setup: Wi-Fi, time sync, then open the session. */
void setup() {
  Serial.begin(115200);
  Serial.println("[gemini_setup_minimal][Step 7a] Boot.");

  connectToWifi();
  syncSystemTime();

  Serial.println("[gemini_setup_minimal][Step 7a] Opening WSS connection to the Gemini Live API endpoint...");
  webSocket.onEvent(onWebSocketEvent);
  webSocket.beginSslWithCA(kGeminiHost, kGeminiPort, kGeminiPath, kRootCaCert);
}

/** Services the WebSocket connection, sending the setup message once a connection is flagged ready. */
void loop() {
  webSocket.loop();

  if (should_send_setup) {
    should_send_setup = false;
    Serial.println("[gemini_setup_minimal][Step 7a] Sending minimal setup message...");
    webSocket.sendTXT(kSetupMessage);
    Serial.println("[gemini_setup_minimal][Step 7a] sendTXT() returned.");
  }
}
