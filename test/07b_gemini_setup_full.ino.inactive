// Step 7b - Gemini Live Session Setup (full)
// Builds on step 7a's minimal setup message: adds the systemInstruction
// (persona + COMMUNICATION_LANGUAGE + tool-use guidance) and the
// set_board_state function schema, then confirms setupComplete. This is
// the rest of step 7 - there is no separate 7c; once this passes, step 7
// as a whole is done.
//
// Requires the "WebSockets" library by Markus Sattler (Links2004),
// installable via the Arduino Library Manager.

#include <WiFi.h>
#include <WebSocketsClient.h>
#include "config.h"

namespace {
const char kGeminiHost[] = "generativelanguage.googleapis.com";
constexpr uint16_t kGeminiPort = 443;
const char kGeminiPath[] =
    "/ws/google.ai.generativelanguage.v1beta.GenerativeService.BidiGenerateContent?key=" GEMINI_API_KEY;

