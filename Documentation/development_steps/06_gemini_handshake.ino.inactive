// Step 6 - TLS/WSS Handshake to the Gemini Live API
// Connects to Wi-Fi, syncs time (required for TLS certificate validation),
// then opens a secure WebSocket connection to the Gemini Live API
// endpoint. No setup message is sent yet - this step only confirms the
// handshake itself succeeds (TLS + HTTP upgrade to WebSocket).
//
// Requires the "WebSockets" library by Markus Sattler (Links2004),
// installable via the Arduino Library Manager.

#include <WiFi.h>
#include <WebSocketsClient.h>
#include "config.h"

namespace {
const char kGeminiHost[] = "generativelanguage.googleapis.com";
constexpr uint16_t kGeminiPort = 443;
const char kGeminiPath[] =
    "/ws/google.ai.generativelanguage.v1beta.GenerativeService.BidiGenerateContent?key=" GEMINI_API_KEY;

