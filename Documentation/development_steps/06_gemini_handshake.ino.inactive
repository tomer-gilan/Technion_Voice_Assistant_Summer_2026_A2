/** Blocks until Wi-Fi connects, logging progress and the assigned IP. */
void connectToWifi() {
  Serial.printf("[gemini_handshake][Step 6] Connecting to Wi-Fi SSID \"%s\"...\n", WIFI_SSID);
  WiFi.mode(WIFI_STA);
  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);

  while (WiFi.status() != WL_CONNECTED) {
    delay(300);
    Serial.print(".");
  }

  Serial.println();
  Serial.printf("[gemini_handshake][Step 6] Wi-Fi connected. IP address: %s\n", WiFi.localIP().toString().c_str());
}

/** Blocks until SNTP has set a plausible system time, required for TLS cert validation. */
void syncSystemTime() {
  Serial.println("[gemini_handshake][Step 6] Syncing time via SNTP (required for TLS cert validation)...");
  configTime(0, 0, "pool.ntp.org", "time.nist.gov");

  time_t now = time(nullptr);
  while (now < 8 * 3600 * 2) {  // still near the 1970 epoch means time hasn't synced yet
    delay(300);
    Serial.print(".");
    now = time(nullptr);
  }

  Serial.println();
  Serial.printf("[gemini_handshake][Step 6] Time synced: %s", asctime(gmtime(&now)));
}

/** Handles WebSocket lifecycle events and logs each one descriptively. */
void onWebSocketEvent(WStype_t type, uint8_t* payload, size_t length) {
  switch (type) {
    case WStype_CONNECTED:
      Serial.println("[gemini_handshake][Step 6] WSS handshake succeeded - connection is open.");
      break;
    case WStype_DISCONNECTED:
      Serial.println("[gemini_handshake][Step 6] Disconnected from the server.");
      break;
    case WStype_TEXT:
      Serial.printf("[gemini_handshake][Step 6] Received text frame: %.*s\n", (int)length, payload);
      break;
    case WStype_ERROR:
      Serial.printf("[gemini_handshake][Step 6] WebSocket error: %.*s\n", (int)length, payload);
      break;
    default:
      break;
  }
}

/** One-time setup: Wi-Fi, time sync, then open the secure WebSocket connection. */
void setup() {
  Serial.begin(115200);
  Serial.println("[gemini_handshake][Step 6] Boot.");

  connectToWifi();
  syncSystemTime();

  Serial.println("[gemini_handshake][Step 6] Opening WSS connection to the Gemini Live API endpoint...");
  webSocket.onEvent(onWebSocketEvent);
  webSocket.beginSslWithCA(kGeminiHost, kGeminiPort, kGeminiPath, kRootCaCert);
}

/** Services the WebSocket connection continuously - required by this library. */
void loop() {
  webSocket.loop();
}
