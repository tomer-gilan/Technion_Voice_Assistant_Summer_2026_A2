// Step 8a - Gemini Live Text Round Trip
// Sends one hardcoded test message via clientContent right after
// setupComplete, and parses the serverContent reply with ArduinoJson -
// printing the extracted text to Serial. This validates real JSON field
// extraction and the basic send/receive turn cycle before audio's
// binary/base64 complexity is added on top in step 8b.
//
// NOTE: originally this used responseModalities: ["TEXT"], which silently
// never got a reply - native-audio Live models (gemini-3.8-live included)
// only support AUDIO output; requesting TEXT is accepted at setup but the
// model then has nothing it can produce, so no serverContent ever arrives.
// Fixed by keeping AUDIO modality and adding outputAudioTranscription, so
// the spoken reply's transcript comes back as plain text
// (serverContent.outputTranscription.text) - the audio itself is received
// but intentionally ignored here (that's step 8c's job).
//
// Requires the "WebSockets" library by Markus Sattler (Links2004) and
// "ArduinoJson" by Benoit Blanchon (v7), both installable via the Arduino
// Library Manager.

#include <WiFi.h>
#include <WebSocketsClient.h>
#include <ArduinoJson.h>
#include "config.h"

namespace {
const char kGeminiHost[] = "generativelanguage.googleapis.com";
constexpr uint16_t kGeminiPort = 443;
const char kGeminiPath[] =
    "/ws/google.ai.generativelanguage.v1beta.GenerativeService.BidiGenerateContent?key=" GEMINI_API_KEY;

